# Turso / libSQL
TURSO_CONNECTION_URL=your_turso_database_url_here
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Better Auth (required in production)
BETTER_AUTH_SECRET=your_better_auth_secret_here
# Optional: canonical site URL for auth callbacks (e.g. https://your-app.vercel.app)
BETTER_AUTH_URL=your_production_site_url_here

# Public site URL (SSR auth client fallback when window is unavailable)
NEXT_PUBLIC_SITE_URL=your_production_site_url_here

# Stripe (test mode)
STRIPE_TEST_KEY=your_stripe_secret_test_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_test_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

# Autumn billing
AUTUMN_SECRET_KEY=your_autumn_secret_key_here
AUTUMN_SANDBOX_SECRET_KEY=your_autumn_sandbox_secret_key_here
